# คัดลอกเป็น .env แล้วใส่เฉพาะที่ใช้ — ไม่มีคีย์ cloud เลย April ใช้โมเดลในเครื่องอย่างเดียว

# ตัวตน
APRIL_OWNER_NAME=
APRIL_PARTICLE=ครับ
APRIL_TIMEZONE=Asia/Bangkok

# โมเดล: auto | local | claude-opus | claude-sonnet | claude-haiku | gpt-oss | openai | gemini
APRIL_DEFAULT_MODEL=auto
APRIL_LOCAL_MODEL=qwen3.5:4b

# คีย์ cloud
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OPENAI_API_KEY=
APRIL_OPENAI_MODEL=
GEMINI_API_KEY=
APRIL_GEMINI_MODEL=

# งานเชิงรุก
APRIL_BRIEFING_TIME=07:30
APRIL_NOTIFY_MAC=true

# ความปลอดภัย
APRIL_ALLOW_ACTIONS=true
APRIL_API_TOKEN=
