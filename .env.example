# คัดลอกเป็น .env แล้วใส่เฉพาะที่ใช้ — ไม่มีคีย์ cloud เลย April ใช้โมเดลในเครื่องอย่างเดียว

# ตัวตน
APRIL_OWNER_NAME=
APRIL_PARTICLE=ครับ
APRIL_TIMEZONE=Asia/Bangkok

# โมเดล: auto | local | claude-opus | claude-sonnet | claude-haiku | gpt-oss | openai | gemini
APRIL_DEFAULT_MODEL=auto
APRIL_LOCAL_MODEL=qwen3.5:4b

# คีย์ cloud
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OPENAI_API_KEY=
APRIL_OPENAI_MODEL=
GEMINI_API_KEY=
APRIL_GEMINI_MODEL=

# งานเชิงรุก
APRIL_BRIEFING_TIME=07:30
APRIL_NOTIFY_MAC=true

# การมองเห็น (กล้อง Mac — โหมดเปิด/ปิดกล้องเลือกในแอป แท็บการมองเห็น)
APRIL_VISION_MODEL=local          # โมเดลที่เฝ้าดู/สรุปเหตุการณ์เบื้องหลัง (local = ภาพไม่ออกนอกเครื่อง)
APRIL_VISION_CLOUD=true           # false = ภาพกล้องไม่ส่งให้ cloud เลย (cloud ได้แค่ผลตรวจจับเป็นข้อความ)
APRIL_VISION_ALERTS=true          # แจ้ง + พูดเมื่อมีเหตุการณ์ (ขยับตอนไม่มีคน, สัตว์, ทักทายตอนกลับมา)

# ความปลอดภัย
APRIL_ALLOW_ACTIONS=true
APRIL_API_TOKEN=
